# CHECK README IN THIS DIRECTORY FOR MORE EXPLANATION ON PARAMETERS IN THIS
# FILE.
#
# Sweeps the classic RFC 2544 frame sizes against a handful of flow counts,
# binary-searching for the max no-loss throughput per (size, flows)
# combination up to line rate (startspeed=100, no ramp_step) -- 7 sizes x 3
# flow counts = 21 pushed data points, meant to be graphed as
# throughput/latency/loss vs packet size, one series per flow count (see
# the "rapidPROX Sweep" Grafana dashboard bundled with charts/prox). Each
# (flows, size) combination is pushed to Pushgateway under its own grouping
# key (see RapidTest.post_data in rapid_test.py) so all 21 points persist
# simultaneously instead of only the last one.

[TestParameters]
name = PacketSizeFlowsSweep
number_of_tests = 1
total_number_of_test_machines = 2
lat_percentile = 99

[TestM1]
name = Generator
config_file = configs/gen.cfg
dest_machine = Swap
mcore = [0]
gencores = [1]
latcores = [3]

[TestM2]
name = Swap
config_file = configs/swap.cfg
mcore = [0]
cores = [1]

[test1]
test=flowsizetest
warmupflowsize=512
warmupimix=[64]
warmupspeed=1
warmuptime=2
# One fixed size per test (single-element imix = no size averaging) --
# standard RFC 2544 frame sizes.
imixs=[[64],[128],[256],[512],[1024],[1280],[1518]]
# Small/medium/large flow counts (powers of 2, see README).
flows=[64,8192,524288]
drop_rate_threshold = 0.1
lat_avg_threshold = 50
lat_perc_threshold = 80
lat_max_threshold = inf
accuracy = 1
# Upper bound of the binary search (see new_speed()/get_start_speed_and_init()
# in rapid_flowsizetest.py: maxspeed is initialized to startspeed and only
# ever lowered on a failed/lossy iteration, never raised) -- NOT just a
# starting point. speed is always a percentage of a fixed 10Gb/s reference
# (get_percentageof10Gbps/get_pps in rapid_test.py), regardless of the
# actual NIC's rated speed. 100 lets the search discover throughput up to
# full 10Gb/s line rate per frame size; lower it only to deliberately cap
# the sweep below line rate.
startspeed = 100
