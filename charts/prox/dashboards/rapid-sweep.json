{
  "uid": "rapidprox-sweep",
  "title": "rapidPROX Sweep",
  "description": "Throughput/latency/loss vs packet size from a rapidPROX sweep (e.g. rapid/tests/sweep_pktsize_flows.test) -- one X-Y chart per metric, one line per flow count. Only uses results that carry both flows and size labels (i.e. pushed via a FlowSizeTest/ImpairTest sweep, not other test types).",
  "tags": ["rapidprox"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "xychart",
      "title": "Throughput (Mpps) vs packet size",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "label_replace(RevByCore{job=\"rapid\", flows=~\".+\"}, \"__name__\", \"Mpps\", \"\", \"\")", "instant": true, "refId": "A" }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "namespace": true, "pod": true, "service": true, "container": true, "endpoint": true },
            "indexByName": { "size": 0, "Mpps": 1 },
            "renameByName": {}
          }
        },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "size", "destinationType": "number" }, { "targetField": "flows", "destinationType": "number" }], "fields": {} } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "flows" }, { "field": "size" }] } },
        { "id": "partitionByValues", "options": { "fields": ["flows"], "keepFields": false } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "show": "points+lines", "pointSize": { "fixed": 5 }, "lineWidth": 2, "axisPlacement": "auto" }
        }
      },
      "options": {
        "seriesMapping": "auto",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 2,
      "type": "xychart",
      "title": "Throughput (Gbps) vs packet size",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "label_replace(Total{job=\"rapid\", flows=~\".+\"} / 1000, \"__name__\", \"Gbps\", \"\", \"\")", "instant": true, "refId": "A" }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "namespace": true, "pod": true, "service": true, "container": true, "endpoint": true },
            "indexByName": { "size": 0, "Gbps": 1 },
            "renameByName": {}
          }
        },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "size", "destinationType": "number" }, { "targetField": "flows", "destinationType": "number" }], "fields": {} } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "flows" }, { "field": "size" }] } },
        { "id": "partitionByValues", "options": { "fields": ["flows"], "keepFields": false } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "show": "points+lines", "pointSize": { "fixed": 5 }, "lineWidth": 2, "axisPlacement": "auto" }
        }
      },
      "options": {
        "seriesMapping": "auto",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 3,
      "type": "xychart",
      "title": "Latency (µs) vs packet size",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        { "expr": "label_replace(PCTLatency{job=\"rapid\", flows=~\".+\"}, \"__name__\", \"Latency\", \"\", \"\")", "instant": true, "refId": "A" }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "namespace": true, "pod": true, "service": true, "container": true, "endpoint": true },
            "indexByName": { "size": 0, "Latency": 1 },
            "renameByName": {}
          }
        },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "size", "destinationType": "number" }, { "targetField": "flows", "destinationType": "number" }], "fields": {} } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "flows" }, { "field": "size" }] } },
        { "id": "partitionByValues", "options": { "fields": ["flows"], "keepFields": false } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "show": "points+lines", "pointSize": { "fixed": 5 }, "lineWidth": 2, "axisPlacement": "auto" }
        }
      },
      "options": {
        "seriesMapping": "auto",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 4,
      "type": "xychart",
      "title": "Loss Ratio (%) vs packet size",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "expr": "label_replace((Lost{job=\"rapid\", flows=~\".+\"} / Sent{job=\"rapid\", flows=~\".+\"}) * 100, \"__name__\", \"LossPercent\", \"\", \"\")", "instant": true, "refId": "A" }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "namespace": true, "pod": true, "service": true, "container": true, "endpoint": true },
            "indexByName": { "size": 0, "LossPercent": 1 },
            "renameByName": {}
          }
        },
        { "id": "convertFieldType", "options": { "conversions": [{ "targetField": "size", "destinationType": "number" }, { "targetField": "flows", "destinationType": "number" }], "fields": {} } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "flows" }, { "field": "size" }] } },
        { "id": "partitionByValues", "options": { "fields": ["flows"], "keepFields": false } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "show": "points+lines", "pointSize": { "fixed": 5 }, "lineWidth": 2, "axisPlacement": "auto" }
        }
      },
      "options": {
        "seriesMapping": "auto",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    }
  ]
}
